{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "react-native"],
    "lib": ["es2020", "dom"],
    "target": "es2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
